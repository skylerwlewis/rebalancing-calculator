{
  "extends": "../tsconfig.node.json",
  "compilerOptions": {
    /* These scripts run with Node's type stripping: only erasable syntax, and type-only imports must say so. */
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["./**/*.ts"]
}
